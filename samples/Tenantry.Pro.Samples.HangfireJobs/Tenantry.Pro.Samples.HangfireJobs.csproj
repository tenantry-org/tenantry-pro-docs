<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <!-- Hangfire allows the vulnerable Newtonsoft.Json 11.0.1: raise it, as every Hangfire application should -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Tenantry.Core" Version="$(TenantryCoreVersion)" />
    <PackageReference Include="Tenantry.AspNetCore" Version="$(TenantryCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tenantry.Pro" Version="$(TenantryProVersion)" />
    <PackageReference Include="Tenantry.Pro.Hangfire" Version="$(TenantryProVersion)" />
  </ItemGroup>

</Project>
