<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Oracle's EF Core provider: Pomelo has no EF Core 10 release (on EF Core 8 or 9, use Pomelo).
         Tenantry.Pro.EfCore.MySql provisions databases with MySqlConnector and works with both. -->
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Tenantry.Core" Version="$(TenantryCoreVersion)" />
    <PackageReference Include="Tenantry.AspNetCore" Version="$(TenantryCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tenantry.Pro" Version="$(TenantryProVersion)" />
    <PackageReference Include="Tenantry.Pro.EfCore.MySql" Version="$(TenantryProVersion)" />
  </ItemGroup>

</Project>
